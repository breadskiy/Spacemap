# SpaceMap Environment Configuration Example
# Copy this file to .env and configure for your production server

# PostgreSQL Database
POSTGRES_DB=indoor_maps
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_db_password_here

# FastAPI Backend
DATABASE_URL=postgresql://postgres:your_secure_db_password_here@db:5432/indoor_maps
SECRET_KEY=generate_a_random_secret_key_here

# Web Server Port
PORT=80
